{
  "Comment": "Enterprise E-Commerce ETL Pipeline (Bronze -> Silver -> Gold)",
  "StartAt": "ParallelSilverTransformations",
  "States": {
    "ParallelSilverTransformations": {
      "Type": "Parallel",
      "Next": "ParallelGoldAggregations",
      "Branches": [
        {
          "StartAt": "UpdateUsersSilver",
          "States": {
            "UpdateUsersSilver": {
              "Type": "Task",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString": "CREATE TABLE IF NOT EXISTS silver_users WITH (format = 'PARQUET') AS SELECT * FROM bronze_users;",
                "WorkGroup": "enterprise-analytics"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "UpdateProductsSilver",
          "States": {
            "UpdateProductsSilver": {
              "Type": "Task",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString": "CREATE TABLE IF NOT EXISTS silver_products WITH (format = 'PARQUET') AS SELECT * FROM bronze_products;",
                "WorkGroup": "enterprise-analytics"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "UpdateCartsSilver",
          "States": {
            "UpdateCartsSilver": {
              "Type": "Task",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString": "CREATE TABLE IF NOT EXISTS silver_carts WITH (format = 'PARQUET') AS SELECT * FROM bronze_carts;",
                "WorkGroup": "enterprise-analytics"
              },
              "End": true
            }
          }
        }
      ]
    },
    "ParallelGoldAggregations": {
      "Type": "Parallel",
      "End": true,
      "Branches": [
        {
          "StartAt": "UpdateExecutiveFunnel",
          "States": {
            "UpdateExecutiveFunnel": {
              "Type": "Task",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString": "CREATE OR REPLACE VIEW gold_executive_funnel AS SELECT count(cart_id) as total_carts FROM silver_carts;",
                "WorkGroup": "enterprise-analytics"
              },
              "End": true
            }
          }
        }
      ]
    }
  }
}